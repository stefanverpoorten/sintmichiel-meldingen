# ---------- Database (Vercel vult deze automatisch in na het koppelen van Neon Postgres) ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meldingen"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/meldingen"

# ---------- Foto-opslag (Vercel vult dit automatisch in na het koppelen van Vercel Blob) ----------
# Lokaal mag je dit leeg laten: dan komen foto's in de map .lokale-opslag
BLOB_READ_WRITE_TOKEN=""

# ---------- Inloggen (Auth.js) ----------
# Een lange willekeurige tekst. Maak er een met:  npx auth secret   of   openssl rand -base64 32
AUTH_SECRET="vervang-mij-door-een-lange-willekeurige-tekst"

# ---------- Microsoft Entra (zie README, hoofdstuk 4) ----------
ENTRA_TENANT_ID=""                     # Directory (tenant) ID
AUTH_MICROSOFT_ENTRA_ID_ID=""          # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=""      # Client secret (de "Value")

# ---------- Wie mag wat ----------
ADMIN_EMAILS="geert.demeulemeester@sintmichiel.be,stefan.verpoorten@sintmichiel.be"
NOTIFY_EMAILS="geert.demeulemeester@sintmichiel.be,stefan.verpoorten@sintmichiel.be"

# ---------- Mail ----------
MAIL_FROM="stefan.verpoorten@sintmichiel.be"
MAIL_MODE="test"                       # "test" = enkel loggen, "live" = echt versturen

# ---------- Overige ----------
APP_URL="http://localhost:3000"        # op Vercel: https://<jouw-project>.vercel.app
RATE_LIMIT_MAX="5"                     # max. aantal aanvragen per IP-adres...
RATE_LIMIT_WINDOW_MIN="15"             # ...binnen zoveel minuten

# Webadres van het gecombineerde formulier (sintmichiel-formulier). Alleen dat adres mag dit formulier
# in een kader tonen. Leeg laten als je het gecombineerde formulier niet gebruikt.
FORMULIER_URL="http://localhost:3002"

# Testlogin zonder Microsoft (werkt NOOIT op Vercel, enkel lokaal)
AUTH_DEV_LOGIN="true"
