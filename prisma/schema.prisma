// Datamodel van de meldingsapp.
// Elke "model" hieronder wordt een tabel in de database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Soort {
  DEFECT
  TAAK
  GEVAARLIJK // gevaarlijke situatie
}

enum Status {
  G
  NG
}

enum Controle {
  OK
  NOK
}

enum MailType {
  NIEUWE_AANVRAAG // naar directeur/beheerder
  ONTVANGST // ontvangstbevestiging naar aanvrager
  STATUS_G // aanvraag doorgegeven
  STATUS_NG // aanvraag niet uitgevoerd
}

enum MailStatus {
  VERSTUURD
  MISLUKT
  TEST // testmodus: niet echt verstuurd, enkel gelogd
}

model Aanvraag {
  id               String     @id @default(cuid())
  volgnummer       String     @unique // bv. 2026-0001
  ingediendOp      DateTime   @default(now())
  naam             String
  email            String
  soort            Soort
  directGevaar     Boolean? // enkel bij een gevaarlijke situatie: is er direct gevaar?
  campus           String
  locatie          String
  beschrijving     String

  // Beheervelden
  status           Status?
  ngReden          String?
  prioriteit       Int?
  klusjesmanId     String?
  klusjesman       Klusjesman? @relation(fields: [klusjesmanId], references: [id])
  controle         Controle?
  controleDatum    DateTime?
  interneOpmerking String?

  fotos            Foto[]
  historiek        Historiek[]
  mails            Mail[]

  // Indexen voor snelle overzichten, filters en sortering
  @@index([status, controle, ingediendOp]) // actief overzicht en "Niet uitgevoerd"
  @@index([controle, controleDatum]) // archief per schooljaar
  @@index([ingediendOp])
  @@index([klusjesmanId, status, controle]) // afdruklijst per klusjesman
  @@index([campus])
  @@index([soort])
  @@index([prioriteit])
}

model Foto {
  id          String   @id @default(cuid())
  aanvraagId  String
  aanvraag    Aanvraag @relation(fields: [aanvraagId], references: [id])
  pad         String // pad naar de verkleinde foto in de opslag
  miniatuur   String // pad naar de miniatuur
  bestandsnaam String
  grootte     Int
  volgorde    Int      @default(0)
  aangemaakt  DateTime @default(now())

  @@index([aanvraagId, volgorde])
}

model Klusjesman {
  id         String     @id @default(cuid())
  naam       String
  actief     Boolean    @default(true)
  aangemaakt DateTime   @default(now())
  aanvragen  Aanvraag[]

  @@index([actief, naam])
}

model Historiek {
  id          String   @id @default(cuid())
  aanvraagId  String
  aanvraag    Aanvraag @relation(fields: [aanvraagId], references: [id])
  tijdstip    DateTime @default(now())
  door        String // e-mailadres van de beheerder, of "aanvrager"/"systeem"
  veld        String
  oudeWaarde  String?
  nieuweWaarde String?

  @@index([aanvraagId, tijdstip])
}

model Mail {
  id          String     @id @default(cuid())
  aanvraagId  String?
  aanvraag    Aanvraag?  @relation(fields: [aanvraagId], references: [id])
  type        MailType
  aan         String // komma-gescheiden
  onderwerp   String
  inhoud      String // HTML
  status      MailStatus
  fout        String?
  pogingen    Int        @default(1)
  aangemaakt  DateTime   @default(now())
  verstuurdOp DateTime?

  @@index([aanvraagId, type, aangemaakt])
  @@index([aangemaakt])
  @@index([status, aangemaakt])
}

// Teller voor de volgnummers, één rij per jaar.
model Teller {
  jaar    Int @id
  laatste Int @default(0)
}

// Inzendingen per (gehasht) IP-adres, voor rate limiting.
model Inzending {
  id         String   @id @default(cuid())
  ipHash     String
  tijdstip   DateTime @default(now())

  @@index([ipHash, tijdstip])
  @@index([tijdstip])
}

// Reserve-opslag voor foto's wanneer Vercel Blob niet beschikbaar is.
model FotoBestand {
  id          String   @id @default(cuid())
  contentType String
  data        Bytes
  aangemaakt  DateTime @default(now())
}

// Aangepaste mailteksten. Bestaat er geen rij voor een mail, dan wordt de standaardtekst gebruikt.
model MailSjabloon {
  type          MailType @id
  onderwerp     String
  inhoud        String
  gewijzigdOp   DateTime @updatedAt
  gewijzigdDoor String?
}
